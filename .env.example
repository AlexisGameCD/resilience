# PROJECT RESILIENCE-ALPHA : variables d'environnement (exemple)
# Copier ce fichier en .env puis adapter. Ne jamais committer le fichier .env reel.
# En demonstration, les secrets runtime sont servis par Vault ; ce fichier sert au bootstrap.

# Base de donnees (fictive, aucune donnee bancaire reelle)
POSTGRES_USER=payalpha
POSTGRES_PASSWORD=OjbwXUOIsVp5otjb2GM0O0Sk
POSTGRES_DB=payalpha

# Signature des jetons JWT (generer une valeur aleatoire forte en demo)
JWT_SECRET=95f94ef16d114244834e7851164caf69e2b481be27dba5ed807d62703fc67a68

# Grafana
GRAFANA_PASSWORD=ED48hWDiCyBdKfwswSya

# Vault (mode dev pour la demonstration uniquement)
VAULT_DEV_TOKEN=root-demo-token

# Cle d'appel du moteur de remediation (API interne)
REM_API_KEY=a3c91924c8a2134cb2617a6ef1dfeb0a

# Assistant RAG : Ollama tourne sur le PC Hote ou le PC IA
# Sur le PC Hote : http://host.docker.internal:11434
# Sur le PC IA   : http://<ip_PC_IA>:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Portainer : installe SEPAREMENT (hors stack), c'est lui qui deploie cette stack.
# Le moteur de remediation l'appelle via le PC Hote (host.docker.internal).
PORTAINER_URL=http://host.docker.internal:9000
PORTAINER_USER=admin
PORTAINER_PASSWORD=azertyuiopqs
# Optionnel : jeton d'acces Portainer (prefere au couple user/mot de passe)
PORTAINER_API_KEY=ptr_+SmPqEyaiRfWuam2rU/nJWOBGqcm0ADPBCIDvm48G4E=
# Identifiant de l'environnement Docker local dans VOTRE Portainer (souvent 1)
PORTAINER_ENDPOINT_ID=2

# Semaphore (automatisation Ansible, chemin d'audit)
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=88Ep3GzIp5SfFDNF5iwB
# Renseignes apres le bootstrap Semaphore (voir docs/portainer-semaphore.md)
SEMAPHORE_API_TOKEN=tve8rie-ijdmuc_hc54hmb6aniubcaaiskoxuh2eabu=
SEMAPHORE_PROJECT_ID=1
SEMAPHORE_TEMPLATE_ID=1

# Jeton protegeant la console d'habilitations (a changer pour la demo).
FACE_ADMIN_TOKEN=admin-resilience-2026

# Seuil de reconnaissance LBPH : distance, plus BAS = plus strict (50 strict, 90 permissif).
FACE_LBPH_THRESHOLD=70

# Anti-abus : nombre d'echecs avant blocage, et duree du blocage (secondes).
FACE_MAX_FAILS=2
FACE_LOCK_SECONDS=300

# Periode de clignotement de la LED (ms).
LED_BLINK_MS=500