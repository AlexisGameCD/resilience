{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "PayAlpha : sante et incident",
  "tags": ["resilience-alpha"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Debit de requetes payment-api (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"payment-api\"}[1m]))",
          "legendFormat": "req/s" }
      ]
    },
    {
      "id": 2,
      "title": "Taux d'erreur 5xx (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"payment-api\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_requests_total{service=\"payment-api\"}[1m])), 0.001)",
          "legendFormat": "erreurs" }
      ]
    },
    {
      "id": 3,
      "title": "Latence p95 payment-api (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"payment-api\"}[1m])) by (le))",
          "legendFormat": "p95" }
      ]
    },
    {
      "id": 4,
      "title": "Transactions reussies (cumul)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A",
          "expr": "payment_tx_success_total",
          "legendFormat": "transactions OK" }
      ]
    },
    {
      "id": 5,
      "title": "Journaux erreurs (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A",
          "expr": "{service=~\"payment-api|auth-service|waf\"} |= \"ERROR\"" }
      ]
    }
  ]
}
